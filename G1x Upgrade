	A.Looped = Looped or false
	A:Play() 
	return A 
end 

function Frame(parent,Size,Position) 
	B=Instance.new("Frame",parent)
	B.Size = Size 
	B.Position = Position 
	return B 
end 

function ScrollFrame(parent,Size,Position) 
    B=Instance.new("ScrollingFrame",parent) 
    B.Size = Size 
    B.Position = Position 
