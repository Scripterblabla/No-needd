function AddTab(parent,tabparent,text,cValue, onClickCallback) 
    if cValue ~= nil then 
        D=Frame(tabparent,UDim2.new(1,0,1,0),UDim2.new(0,0,0,0)) 
        D.Transparency = 1 
        D.BorderSizePixel = 0 
        D.Name = text 
        D.Visible = false 
        if cValue.Value == 0 then D.Visible = true end 
        Instance.new("IntValue",D).Name = "IsATab" 
        
        C=Button(parent,text,UDim2.new(1,-10,0,35),UDim2.new(0,5,0,5+(40*cValue.Value)),function() 
            for i, v in pairs(tabparent:GetChildren()) do 
                if v.Name == text then 
                    v.Visible = true 
                else 
                    v.Visible = false 
                end 
            end 
            if onClickCallback then onClickCallback() end
        end) 
        C.Style = Enum.ButtonStyle.Custom 
        C.BackgroundColor3 = Color3.fromRGB(0,0,0) 
        C.BackgroundTransparency = 0.85 
        C.BorderSizePixel = 0 
        Instance.new("IntValue",C).Name = "IsATabButton" 
        
        cValue.Value = cValue.Value + 1 
        if parent.Parent.ClassName == "ScrollingFrame" then 
            parent.Parent.CanvasSize = UDim2.new(0,0,0,5+(40*(cValue.Value))) 
        end 
        return D, C 
    end 
end 

local function ApplyChromeEffect(obj, cornerRadius, strokeThickness)
    if obj:IsA("Frame") then
        obj.Style = Enum.FrameStyle.Custom
    elseif obj:IsA("TextButton") then
        obj.Style = Enum.ButtonStyle.Custom
    end
    
    obj.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    obj.BorderSizePixel = 0
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, cornerRadius or 12)
    UICorner.Parent = obj
    
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Thickness = strokeThickness or 4
    UIStroke.Color = Color3.fromRGB(255, 255, 255)
    UIStroke.Parent = obj
    
    local UIGradient = Instance.new("UIGradient")
    UIGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),     
        ColorSequenceKeypoint.new(0.2, Color3.fromRGB(170, 170, 170)),   
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(50, 50, 50)),      
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(255, 255, 255)),  
        ColorSequenceKeypoint.new(0.7, Color3.fromRGB(110, 110, 110)),   
        ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 220, 220))      
    })
    UIGradient.Parent = UIStroke
    
    task.spawn(function()
        local angle = 0
        if RunService then
            RunService.RenderStepped:Connect(function()
                angle = (angle + 1) % 360
                UIGradient.Rotation = angle
            end)
        else
            while task.wait(0.02) do
                angle = (angle + 1.5) % 360
                UIGradient.Rotation = angle
            end
        end
    end)
end

local function CreateSnowEffect(parentFrame)
    parentFrame.ClipsDescendants = true
    
    local SnowContainer = Instance.new("Frame")
    SnowContainer.Name = "SnowEffectContainer"
    SnowContainer.Size = UDim2.new(1, 0, 1, 0)
    SnowContainer.BackgroundTransparency = 1
    SnowContainer.ZIndex = 1
    SnowContainer.Parent = parentFrame
    
    task.spawn(function()
        while task.wait(0.08) do
            if not parentFrame or not parentFrame.Parent then break end
            
            local SizeRand = math.random(2, 5)
            local Snowflake = Instance.new("Frame")
            Snowflake.Size = UDim2.new(0, SizeRand, 0, SizeRand)
            Snowflake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Snowflake.BackgroundTransparency = math.random(20, 50) / 100
            Snowflake.BorderSizePixel = 0
            Snowflake.Position = UDim2.new(math.random(0, 1000) / 1000, 0, -0.05, 0)
            Snowflake.ZIndex = 1 
            
            local UICorner = Instance.new("UICorner")
            UICorner.CornerRadius = UDim.new(1, 0)
            UICorner.Parent = Snowflake
            
            Snowflake.Parent = SnowContainer
            
            local duration = math.random(3, 6)
            local targetX = Snowflake.Position.X.Scale + (math.random(-50, 50) / 1000)
            
            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
            local tween = TweenService:Create(Snowflake, tweenInfo, {
                Position = UDim2.new(targetX, 0, 1.05, 0),
                BackgroundTransparency = 1
            })
            
            tween:Play()
            
            tween.Completed:Connect(function()
                Snowflake:Destroy()
            end)
        end
    end)
end

