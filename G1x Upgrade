    return B 
end 

function Label(parent,Text,Size,Position,value) 
    C=Instance.new("TextLabel",parent) 
    C.Size = Size 
    C.Position = Position 
    C.Text = Text 
    C.BackgroundTransparency = 1 
    C.Font = Enum.Font.Legacy 
    C.TextColor3 = Color3.new(1,1,1) 
    C.TextStrokeTransparency = 0.5 
    C.TextWrapped = true 
    if value ~= nil then 
        if value == 1 then C.Size = UDim2.new(1,-10,0,35) end 
        C.Position = UDim2.new(0,0,0,35*value.Value) 
        C.Style = Enum.FrameStyle.Custom 
        C.BackgroundColor3 = Color3.fromRGB(0,0,0) 
        C.BackgroundTransparency = 0.85 
        C.BorderSizePixel = 0 
        value.Value = value.Value + 1 
    end 
    return C 
end 

