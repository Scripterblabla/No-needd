                        PlaySFX(156785206, 0.5, 1)
                        local toToggle = {tileIndex}
                        if col > 1 then table.insert(toToggle, tileIndex - 1) end
                        if col < 3 then table.insert(toToggle, tileIndex + 1) end
                        if row > 1 then table.insert(toToggle, tileIndex - 3) end
                        if row < 3 then table.insert(toToggle, tileIndex + 3) end

                        for _, idx in ipairs(toToggle) do
                            rubikState[idx] = (rubikState[idx] % #RubikColors) + 1
                        end

                        UpdateRubikUI()
                    end)

                    table.insert(tileButtons, btn)
                end
            end

            UpdateRubikUI()
            currentY = currentY + 125

            local ScrambleBtn = Button(Container, "Scramble Rubik", UDim2.new(1, 0, 0, 28), UDim2.new(0, 0, 0, currentY), function()
                for i = 1, 9 do
                    rubikState[i] = math.random(1, #RubikColors)
                end
                UpdateRubikUI()
            end)
            ApplyChromeEffect(ScrambleBtn, 8, 2) 
            currentY = currentY + 35
        end

        ScrollPageAdmin.CanvasSize = UDim2.new(0, 0, 0, currentY + 15)
    end

    RenderAdminContent()
end

