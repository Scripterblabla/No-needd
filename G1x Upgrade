function CustomTextBox(parent, placeholder, size, position) 
    local C = Instance.new("TextBox", parent) 
    C.Size = size 
    C.Position = position 
    C.PlaceholderText = placeholder 
    C.Text = "" 
    C.Font = Enum.Font.Legacy 
    C.TextSize = 12
    C.TextColor3 = Color3.new(1,1,1) 
    C.PlaceholderColor3 = Color3.fromRGB(150,150,150)
    C.BackgroundColor3 = Color3.fromRGB(10,10,10) 
    C.BackgroundTransparency = 0.5 
    C.BorderSizePixel = 0 
    C.ClearTextOnFocus = false
    C.TextWrapped = true
    
    local stroke = Instance.new("UIStroke", C)
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(100, 100, 100)
    
    local corner = Instance.new("UICorner", C)
    corner.CornerRadius = UDim.new(0, 6)
    
    return C 
end

