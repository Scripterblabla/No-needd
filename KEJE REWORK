	local Tool = Instance.new("Tool")
	Tool.Name = "Ravage"
	Tool.RequiresHandle = false
	Tool.Parent = Backpack

	Tool.Activated:Connect(function()
		if isAnimating or not RavageAnim then return end
		local myChar = LocalPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not myHRP then return end

		isAnimating = true
		myHRP.Anchored = true

		task.spawn(function()
			pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/Scripterblabla/Made-By-Scripterblabla-/refs/heads/main/KJ%20Ravage%20Camera%20animation"))()
			end)
		end)

		local track = PlayKeyframeSequence(myChar, RavageAnim, 1)
		track.Priority = Enum.AnimationPriority.Action4
		track.Looped = false 
		
		if RavageSFXId then
			local ravageSound = Instance.new("Sound")
			ravageSound.SoundId = RavageSFXId
			ravageSound.Parent = myHRP
			ravageSound.Volume = 1.5
			ravageSound:Play()
			Debris:AddItem(ravageSound, track.Length + 2)
		end
		
		local vfxClone = nil
		local vfxRenderConn = nil
		
		if RavageVFX then
			vfxClone = RavageVFX:Clone()
			vfxClone.Parent = workspace
			
			local punchesBase = vfxClone:FindFirstChild("RapidPunches", true)
			if punchesBase and punchesBase:IsA("BasePart") then
				
				for _, emitter in ipairs(punchesBase:GetDescendants()) do
					if emitter:IsA("ParticleEmitter") then
						emitter.Enabled = false
						emitter:Clear()
					end
				end
				
				vfxRenderConn = RunService.RenderStepped:Connect(function()
					if myHRP and punchesBase.Parent then
						punchesBase.CFrame = myHRP.CFrame * CFrame.new(0, 1, -3) * CFrame.Angles(0, math.rad(90), 0)
					end
				end)
				
				task.spawn(function()
					task.wait(3.9) 
					
					for _, emitter in ipairs(punchesBase:GetDescendants()) do
						if emitter:IsA("ParticleEmitter") then
							emitter:Emit(20) 
							emitter.Enabled = true
						end
					end
					
					task.wait(2.7) 
					
					for _, emitter in ipairs(punchesBase:GetDescendants()) do
						if emitter:IsA("ParticleEmitter") then
							emitter.Enabled = false
						end
					end
				end)
			end
			Debris:AddItem(vfxClone, track.Length + 2)
		end
		
		task.wait(track.Length)
		
		if vfxRenderConn then vfxRenderConn:Disconnect() end
		track:Stop()
		track:RestoreAnimator()
		myHRP.Anchored = false
		isAnimating = false
	end)
end

