local function ExecuteDropkick()
	if isAnimating or not DropkickAnim then return end
	local myChar = LocalPlayer.Character
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end

	isAnimating = true
	myHRP.Anchored = true

	local victimChar = getNearestR6Player(myHRP.Position, 2000)
	local isDummyCreated = false

	if not victimChar then
		isDummyCreated = true
		victimChar = createR6DummyClone(myChar)
		victimChar.Parent = workspace
	end

	local victimHRP = victimChar:FindFirstChild("HumanoidRootPart")
	local victimOldAnchored = false

	if victimHRP then
		victimOldAnchored = victimHRP.Anchored
		victimHRP.AssemblyLinearVelocity = Vector3.zero
		victimHRP.AssemblyAngularVelocity = Vector3.zero
		victimHRP.Anchored = true
		victimHRP.CFrame = myHRP.CFrame * CFrame.new(0, 0, -3.5) * CFrame.Angles(0, math.pi, 0)
	end

	local dropkickSound = nil
	if DropkickSFXId then
		dropkickSound = Instance.new("Sound")
		dropkickSound.Name = "StyleDropkickSFX"
		dropkickSound.SoundId = DropkickSFXId
		dropkickSound.Volume = 2.5
		dropkickSound.RollOffMaxDistance = 999999
		dropkickSound.Parent = SoundService
		dropkickSound:Play()
	end

	task.spawn(function()
		if DROPKICK_CAM_DELAY > 0 then task.wait(DROPKICK_CAM_DELAY) end
		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/Scripterblabla/Gix-Hub-Anti-Skid/refs/heads/main/Dropkickittttt%20Camera%20animation"))()
		end)
	end)

	local charTrack = nil
	task.spawn(function()
		if DROPKICK_CHAR_DELAY > 0 then task.wait(DROPKICK_CHAR_DELAY) end
		if myChar and DropkickAnim then
			charTrack = PlayKeyframeSequence(myChar, DropkickAnim, 1)
			charTrack.Priority = Enum.AnimationPriority.Action4
			charTrack.Looped = false
			if DROPKICK_CHAR_START > 0 then
				pcall(function() charTrack.TimePosition = DROPKICK_CHAR_START end)
			end
		end
	end)

	local victimTrack = nil
	task.spawn(function()
		if DROPKICK_VICTIM_DELAY > 0 then task.wait(DROPKICK_VICTIM_DELAY) end
		if victimChar and DropkickVictimAnim then
			victimTrack = PlayKeyframeSequence(victimChar, DropkickVictimAnim, 1)
			victimTrack.Priority = Enum.AnimationPriority.Action4
			victimTrack.Looped = false
			if DROPKICK_VICTIM_START > 0 then
				pcall(function() victimTrack.TimePosition = DROPKICK_VICTIM_START end)
			end
		end
	end)

	task.wait(27)

	if charTrack then
		pcall(function() charTrack:Stop(); charTrack:RestoreAnimator() end)
	end
	if victimTrack then
		pcall(function() victimTrack:Stop(); victimTrack:RestoreAnimator() end)
	end

	if dropkickSound then
		dropkickSound:Stop()
		dropkickSound:Destroy()
	end

	if isDummyCreated then
		if victimChar then victimChar:Destroy() end
	else
		if victimHRP then
			victimHRP.Anchored = victimOldAnchored
		end
	end

	myHRP.Anchored = false
	isAnimating = false

	RestoreAwakeningBarAndTools()
end

local function GiveDropkickTool()
	local backpack = LocalPlayer:WaitForChild("Backpack")
	local tool = Instance.new("Tool")
	tool.Name = "20 Dropkick"
	tool.RequiresHandle = false
	tool.Parent = backpack
	activeDropkickTool = tool

	tool.Activated:Connect(function()
		ExecuteDropkick()
	end)
end

local function Execute20SeriesAwakening(mainFrame, barGui)
	if isAnimating or not Series20Anim then return end
	local myChar = LocalPlayer.Character
	local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myHRP then return end

	isAnimating = true
	myHRP.Anchored = true

	local track = PlayKeyframeSequence(myChar, Series20Anim, 1)
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false 

	if Series20SFXId then
		local series20Sound = Instance.new("Sound")
		series20Sound.SoundId = Series20SFXId
		series20Sound.Parent = myHRP
		series20Sound.Volume = 2.5
		series20Sound:Play()
		Debris:AddItem(series20Sound, track.Length + 2)
	end

	local vfxClone = nil
	local vfxRenderConn = nil
	local auraBase = nil

	if Series20VFX then
		vfxClone = Series20VFX:Clone()
		vfxClone.Parent = workspace
		
		auraBase = vfxClone:FindFirstChild("Aura", true)
		if auraBase and auraBase:IsA("BasePart") then
			vfxRenderConn = RunService.RenderStepped:Connect(function()
				if myHRP and auraBase.Parent then
					auraBase.CFrame = myHRP.CFrame * CFrame.new(0, -2.8, 0)
				end
			end)
			for _, descendant in ipairs(auraBase:GetDescendants()) do
				if descendant:IsA("ParticleEmitter") then
					descendant.Enabled = true
				end
			end
		end
	end

	task.wait(track.Length)

	if auraBase then
		for _, descendant in ipairs(auraBase:GetDescendants()) do
			if descendant:IsA("ParticleEmitter") then
				descendant.Enabled = false
			end
		end
	end

	if vfxRenderConn then vfxRenderConn:Disconnect() end
	if vfxClone then Debris:AddItem(vfxClone, 2) end

	track:Stop()
	track:RestoreAnimator()
	myHRP.Anchored = false
	isAnimating = false

	currentAwakeningMainFrame = mainFrame
	if not currentAwakeningOriginalPos then
		currentAwakeningOriginalPos = mainFrame.Position
	end

	local hiddenPosition = currentAwakeningOriginalPos + UDim2.new(0, 0, 1.2, 0)

	TweenService:Create(mainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = hiddenPosition}):Play()

	savedBackpackTools = {}
	local backpack = LocalPlayer:WaitForChild("Backpack")
	for _, item in ipairs(backpack:GetChildren()) do
		if item:IsA("Tool") then
			table.insert(savedBackpackTools, item)
			item.Parent = nil
		end
	end
	if myChar then
		for _, item in ipairs(myChar:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(savedBackpackTools, item)
				item.Parent = nil
			end
		end
	end

	GiveDropkickTool()
end

local function SetupAwakeningBar()
	if not SeriesBarGuiAsset then return end

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	if playerGui:FindFirstChild("SeriesBarGui") then
		playerGui.SeriesBarGui:Destroy()
	end

	local barGui = SeriesBarGuiAsset:Clone()
	barGui.Name = "SeriesBarGui"
	barGui.Parent = playerGui

	local mainContainer = barGui:FindFirstChildOfClass("Frame") or barGui:FindFirstChildOfClass("ImageLabel") or barGui
	currentAwakeningMainFrame = mainContainer
	currentAwakeningOriginalPos = mainContainer.Position

	local pressTarget = nil
	for _, descendant in ipairs(barGui:GetDescendants()) do
		if descendant:IsA("TextButton") or descendant:IsA("ImageButton") then
			pressTarget = descendant
			break
		elseif descendant:IsA("TextLabel") and (string.find(string.upper(descendant.Text), "PRESS") or string.find(string.upper(descendant.Text), "SERIES")) then
			pressTarget = descendant
		end
	end

	if pressTarget then
		if pressTarget:IsA("TextButton") or pressTarget:IsA("ImageButton") then
			pressTarget.MouseButton1Click:Connect(function()
				Execute20SeriesAwakening(mainContainer, barGui)
			end)
		else
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, 0, 1, 0)
			btn.BackgroundTransparency = 1
			btn.Text = ""
			btn.Parent = pressTarget
			btn.MouseButton1Click:Connect(function()
				Execute20SeriesAwakening(mainContainer, barGui)
			end)
		end
	end
end

