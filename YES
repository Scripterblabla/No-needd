toolSuiryu.Activated:Connect(function()
	if debounceSuiryu or not PlayKeyframeSequence then return end
	debounceSuiryu = true
	local character = player.Character
	if not character then debounceSuiryu = false return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
