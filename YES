local toolSuiryu = Instance.new("Tool")
toolSuiryu.Name = "Suiryu"
toolSuiryu.RequiresHandle = false
toolSuiryu.CanBeDropped = false
toolSuiryu.Parent = player:WaitForChild("Backpack")

local debounceSuiryu = false
local activeSuiryuAnim = nil

toolSuiryu.Activated:Connect(function()
	if debounceSuiryu or not PlayKeyframeSequence then return end
	debounceSuiryu = true

	local character = player.Character
	if not character then debounceSuiryu = false return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local head = character:FindFirstChild("Head")
	if not humanoid or not hrp or not head then debounceSuiryu = false return end

	if activeSuiryuAnim then
		pcall(function() activeSuiryuAnim:Stop(); activeSuiryuAnim:RestoreAnimator() end)
		activeSuiryuAnim = nil
	end

	Controls:Disable()
	local oldSpeed = humanoid.WalkSpeed
	local oldJump = humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight
	humanoid.WalkSpeed = 0
	if humanoid.UseJumpPower then humanoid.JumpPower = 0 else humanoid.JumpHeight = 0 end

	local originalCamSubject = camera.CameraSubject
	camera.CameraSubject = head

	task.spawn(function()
		if SUIRYU_CHAR_DELAY > 0 then task.wait(SUIRYU_CHAR_DELAY) end
		if suiryuAnimSeq and character then
			activeSuiryuAnim = PlayKeyframeSequence(character, suiryuAnimSeq, 1)
			if SKIP_SUIRYU_START > 0 then
				pcall(function() activeSuiryuAnim.TimePosition = SKIP_SUIRYU_START end)
			end
		end
	end)

	local totalWaitTime = (suiryuAnimLength - SKIP_SUIRYU_START) + SUIRYU_CHAR_DELAY
	if STOP_SUIRYU_EARLY > 0 then
		totalWaitTime = STOP_SUIRYU_EARLY
	end

	task.wait(totalWaitTime)

	if activeSuiryuAnim then
		pcall(function() activeSuiryuAnim:Stop(); activeSuiryuAnim:RestoreAnimator() end)
		activeSuiryuAnim = nil
	end

	if originalCamSubject then camera.CameraSubject = originalCamSubject end

	Controls:Enable()
	humanoid.WalkSpeed = oldSpeed
	if humanoid.UseJumpPower then humanoid.JumpPower = oldJump else humanoid.JumpHeight = oldJump end
	if not humanoid:FindFirstChild("Animator") then Instance.new("Animator", humanoid) end

	debounceSuiryu = false
end)

