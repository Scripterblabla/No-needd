local function getNearestPlayer(originPos, radius)
	local nearestChar = nil
	local shortestDist = radius

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
			local pHum = p.Character:FindFirstChildOfClass("Humanoid")
			if pHrp and pHum and pHum.Health > 0 and pHum.RigType == Enum.HumanoidRigType.R6 then
				local dist = (pHrp.Position - originPos).Magnitude
				if dist <= shortestDist then
					shortestDist = dist
					nearestChar = p.Character
				end
			end
		end
	end
	return nearestChar
end

local function createR6DummyClone(baseChar)
	local oldArch = baseChar.Archivable
	baseChar.Archivable = true
	local dummy = baseChar:Clone()
	baseChar.Archivable = oldArch

	for _, v in pairs(dummy:GetDescendants()) do
		if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") or v:IsA("Sound") or v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Decal") or v:IsA("CharacterMesh") or v:IsA("BodyColors") then
			v:Destroy()
		elseif v:IsA("BasePart") then
			v.Color = Color3.fromRGB(163, 162, 165)
			v.Material = Enum.Material.SmoothPlastic
			v.Transparency = 0
			if v.Name == "HumanoidRootPart" then v.Transparency = 1 end
		end
	end
	dummy.Name = "VictimDummy"
	return dummy
end

local function attachGenosArmAccessory(char, assetId, bodyPartName)
	local part = char:FindFirstChild(bodyPartName)
	if not part then return nil end
	
	local success, result = pcall(function()
		return game:GetObjects("rbxassetid://" .. tostring(assetId))[1]
	end)
	
	if success and result then
		result.Parent = char
		if result:IsA("Accessory") or result:IsA("Accoutrement") then
			local handle = result:FindFirstChild("Handle")
			if handle then
				handle.CFrame = part.CFrame
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = part
				weld.Part1 = handle
				weld.Parent = handle
			end
		elseif result:IsA("BasePart") or result:IsA("Model") then
			local primary = result:IsA("Model") and (result.PrimaryPart or result:FindFirstChildOfClass("BasePart")) or result
			if primary then
				if result:IsA("Model") then
					result:SetPrimaryPartCFrame(part.CFrame)
					for _, p in pairs(result:GetDescendants()) do
						if p:IsA("BasePart") and p ~= primary then
							local w = Instance.new("WeldConstraint")
							w.Part0 = primary
							w.Part1 = p
							w.Parent = p
						end
					end
				end
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = part
				weld.Part1 = primary
				weld.Parent = primary
			end
		end
		return result
	end
	return nil
end

