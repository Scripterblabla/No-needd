local function getKeyframeSequence(obj)
	if not obj then return nil end
	if obj:IsA("KeyframeSequence") then return obj end
	return obj:FindFirstChildOfClass("KeyframeSequence", true)
end

local suiryuAnimSeq = getKeyframeSequence(suiryuAnimAsset)
local naoyaAnimSeq = getKeyframeSequence(naoyaAnimAsset)
local judasAnimSeq = getKeyframeSequence(judasAnimAsset)

local function checkLength(seq)
	local length = 0
	if seq then
		for _, kf in pairs(seq:GetKeyframes()) do
			if kf.Time > length then length = kf.Time end
		end
	end
	return length
end

local suiryuAnimLength = checkLength(suiryuAnimSeq)
local naoyaAnimLength = checkLength(naoyaAnimSeq)
local judasAnimLength = checkLength(judasAnimSeq)

if suiryuAnimLength == 0 then suiryuAnimLength = 4 end
if naoyaAnimLength == 0 then naoyaAnimLength = 4 end
if judasAnimLength == 0 then judasAnimLength = 4 end

local PlayerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local Controls = PlayerModule:GetControls()

local metavisionActive = false
local metavisionCC = nil

local function applyMetavisionToCharacter(char)
	if not char or char:FindFirstChild("MetavisionHighlight") or char == player.Character then return end
	local highlight = Instance.new("Highlight")
	highlight.Name = "MetavisionHighlight"
	highlight.Adornee = char
	highlight.FillTransparency = METAVISION_FILL_TRANSPARENCY          
	highlight.OutlineTransparency = METAVISION_OUTLINE_TRANSPARENCY    
	highlight.OutlineColor = METAVISION_OUTLINE_COLOR
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = char
end

local function removeMetavisionFromCharacter(char)
	if not char then return end
	local highlight = char:FindFirstChild("MetavisionHighlight")
	if highlight then
		highlight:Destroy()
	end
end

local function toggleMetavision(state)
	metavisionActive = state
	
	if metavisionActive then
		metaSound:Play()
		if not metavisionCC then
			metavisionCC = Instance.new("ColorCorrectionEffect")
			metavisionCC.Name = "MetavisionCC"
			metavisionCC.Saturation = -0.6
			metavisionCC.Contrast = 0.4
			metavisionCC.TintColor = Color3.fromRGB(180, 225, 255)
			metavisionCC.Parent = Lighting
		end
		
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				applyMetavisionToCharacter(p.Character)
			end
		end
		
		TweenService:Create(camera, TweenInfo.new(0.3), {FieldOfView = METAVISION_FOV}):Play()
	else
		metaSound:Stop()
		if metavisionCC then
			metavisionCC:Destroy()
			metavisionCC = nil
		end
		
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then
				removeMetavisionFromCharacter(p.Character)
			end
		end
		
		TweenService:Create(camera, TweenInfo.new(0.3), {FieldOfView = 70}):Play()
	end
end

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function(char)
		if metavisionActive and p ~= player then
			task.wait(0.5)
