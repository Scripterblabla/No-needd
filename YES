	task.spawn(function()
		while sandeIsRunning do
			if character and hrp then
				spawnAfterimage(character)
			end
			task.wait(0.08) 
		end
	end)

	task.spawn(function()
		if SANDE_CHAR_DELAY > 0 then task.wait(SANDE_CHAR_DELAY) end
		if sandeAnimSeq and character then
			activeSandeAnim = PlayKeyframeSequence(character, sandeAnimSeq, 1)
			if SKIP_SANDE_START > 0 then
				pcall(function() activeSandeAnim.TimePosition = SKIP_SANDE_START end)
			end
		end
		if sandeVictimAnimSeq and victimChar then
			activeSandeVictimAnim = PlayKeyframeSequence(victimChar, sandeVictimAnimSeq, 1)
			if SKIP_SANDE_START > 0 then
				pcall(function() activeSandeVictimAnim.TimePosition = SKIP_SANDE_START end)
			end
		end
	end)

	local totalWaitTime = (sandeAnimLength - SKIP_SANDE_START) + SANDE_CHAR_DELAY
	if STOP_SANDE_EARLY > 0 then totalWaitTime = STOP_SANDE_EARLY end

	task.wait(totalWaitTime)

	sandeIsRunning = false
	if activeSandeAnim then
		pcall(function() activeSandeAnim:Stop(); activeSandeAnim:RestoreAnimator() end)
		activeSandeAnim = nil
	end
	if activeSandeVictimAnim then
		pcall(function() activeSandeVictimAnim:Stop(); activeSandeVictimAnim:RestoreAnimator() end)
		activeSandeVictimAnim = nil
	end

	if isDummyCreated then
		if victimChar then victimChar:Destroy() end
	else
		if victimHrp then
			victimHrp.AssemblyLinearVelocity = Vector3.zero
			victimHrp.AssemblyAngularVelocity = Vector3.zero
			victimHrp.Anchored = victimOldAnchored
		end
	end

	sandeSound:Stop()

	if originalCamSubject then camera.CameraSubject = originalCamSubject end

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.Anchored = oldAnchored
	
	Controls:Enable()
	humanoid.WalkSpeed = oldSpeed
	if humanoid.UseJumpPower then humanoid.JumpPower = oldJump else humanoid.JumpHeight = oldJump end
	if not humanoid:FindFirstChild("Animator") then Instance.new("Animator", humanoid) end

	debounceSande = false
end)
