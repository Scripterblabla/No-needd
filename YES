local toolJudas = Instance.new("Tool")
toolJudas.Name = "Judas"
toolJudas.RequiresHandle = false
toolJudas.CanBeDropped = false
toolJudas.Parent = player:WaitForChild("Backpack")

local judasActive = false
local judasDummy = nil
local activeJudasAnim = nil
local activeDummyAnim = nil
local judasOldSpeed = 16
local judasOldJump = 50
local freezeConnection = nil

local function createGreyDummy(baseChar)
	local oldArch = baseChar.Archivable
	baseChar.Archivable = true
	local dummy = baseChar:Clone()
	baseChar.Archivable = oldArch
	
	for _, v in pairs(dummy:GetDescendants()) do
		if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") or v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Decal") or v:IsA("CharacterMesh") or v:IsA("BodyColors") then
			v:Destroy()
		elseif v:IsA("BasePart") then
			v.Color = Color3.fromRGB(163, 162, 165) 
			v.Material = Enum.Material.SmoothPlastic
			v.Transparency = 0
			if v.Name == "HumanoidRootPart" then
				v.Transparency = 1
			end
		end
	end
	dummy.Name = "JudasVictimDummy"
	return dummy
end

toolJudas.Activated:Connect(function()
	local character = player.Character
	if not character or not PlayKeyframeSequence then return end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	
	if not humanoid or not hrp then return end
	
	judasActive = not judasActive

	if judasActive then
		Controls:Disable()
		judasOldSpeed = humanoid.WalkSpeed
		judasOldJump = humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight
		humanoid.WalkSpeed = 0
		if humanoid.UseJumpPower then humanoid.JumpPower = 0 else humanoid.JumpHeight = 0 end
		
		judasDummy = createGreyDummy(character)
		
		local dummyHRP = judasDummy:FindFirstChild("HumanoidRootPart")
		if dummyHRP then
			dummyHRP.CFrame = hrp.CFrame * CFrame.new(0, 0, -13) * CFrame.Angles(0, math.pi, 0)
			dummyHRP.Anchored = true
		end
		
		judasDummy.Parent = workspace
		
		judasSound:Play()
		
		if character and judasAnimSeq then
			activeJudasAnim = PlayKeyframeSequence(character, judasAnimSeq, 1)
		end
		if judasDummy and judasAnimSeq then
			activeDummyAnim = PlayKeyframeSequence(judasDummy, judasAnimSeq, 1)
		end
		
		task.spawn(function()
			task.wait(judasAnimLength - 0.05)
			if judasActive then
				freezeConnection = RunService.RenderStepped:Connect(function()
					if activeJudasAnim then pcall(function() activeJudasAnim.TimePosition = judasAnimLength - 0.05 end) end
					if activeDummyAnim then pcall(function() activeDummyAnim.TimePosition = judasAnimLength - 0.05 end) end
				end)
			end
		end)
		
	else
		if freezeConnection then 
			freezeConnection:Disconnect() 
			freezeConnection = nil 
		end
		
		if activeJudasAnim then pcall(function() activeJudasAnim:Stop(); activeJudasAnim:RestoreAnimator() end) activeJudasAnim = nil end
		if activeDummyAnim then pcall(function() activeDummyAnim:Stop(); activeDummyAnim:RestoreAnimator() end) activeDummyAnim = nil end
		
		if judasDummy then
			judasDummy:Destroy()
			judasDummy = nil
		end
		
		judasSound:Stop()
		
		Controls:Enable()
		humanoid.WalkSpeed = judasOldSpeed
		if humanoid.UseJumpPower then humanoid.JumpPower = judasOldJump else humanoid.JumpHeight = judasOldJump end
		if not humanoid:FindFirstChild("Animator") then Instance.new("Animator", humanoid) end
	end
end)
