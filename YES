local function spawnAfterimage(char)
	local oldArch = char.Archivable
	char.Archivable = true
	local clone = char:Clone()
	char.Archivable = oldArch
	
	local trailColors = {
		Color3.fromRGB(0, 255, 255),
		Color3.fromRGB(255, 0, 0),
		Color3.fromRGB(0, 128, 255),
		Color3.fromRGB(255, 85, 255),
		Color3.fromRGB(255, 215, 0),
		Color3.fromRGB(255, 255, 255)
	}
	local randomColor = trailColors[math.random(1, #trailColors)]
	
	for _, v in pairs(clone:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
			v.CanQuery = false
			v.CanTouch = false
			v.Massless = true
			v.CastShadow = false
			
			v.Material = Enum.Material.ForceField 
			v.Color = randomColor 
			
			if v.Name == "HumanoidRootPart" then
				v.Transparency = 1
			else
				v.Transparency = 0.1 
				local tw = TweenService:Create(v, TweenInfo.new(4), {Transparency = 1})
				tw:Play()
			end
		elseif v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") or v:IsA("Sound") or v:IsA("Humanoid") or v:IsA("Decal") or v:IsA("Texture") then
			v:Destroy()
		end
	end
	
	clone.Parent = workspace
	
	task.delay(0.4, function()
		if clone then clone:Destroy() end
	end)
end

